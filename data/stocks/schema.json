{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenFilm film-stock data",
  "description": "One film stock digitised from its published datasheet. Spectra are sampled at 5 nm inside 380-780 nm (only the digitised range is stored); characteristic curves are sampled every 0.05 log E. Every [x, y] array is sorted ascending by x.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "type", "densitometry", "sources", "layers", "dyeDensity", "interlayer"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "type": { "enum": ["negative", "print"] },
    "densitometry": {
      "description": "Densitometry the characteristic curves were measured with: Status M for camera negatives, Status A for print film.",
      "enum": ["statusM", "statusA"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "retrieved", "figures"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "pattern": "^https?://" },
          "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "figures": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "balanceIlluminantK": {
      "description": "Colour temperature (kelvin) the negative is balanced for.",
      "type": "number", "exclusiveMinimum": 0
    },
    "midGreyLogExposure": {
      "description": "log10 exposure (lux-seconds) of an 18% grey card at normal exposure (camera stops 0).",
      "type": "number"
    },
    "labAimDensity": {
      "description": "Laboratory Aim Density of the print, Status A [R, G, B].",
      "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3, "maxItems": 3
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red", "green", "blue"],
      "properties": {
        "red": { "$ref": "#/$defs/layer" },
        "green": { "$ref": "#/$defs/layer" },
        "blue": { "$ref": "#/$defs/layer" }
      }
    },
    "dyeDensity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cyan", "magenta", "yellow"],
      "properties": {
        "cyan": { "$ref": "#/$defs/spectrum" },
        "magenta": { "$ref": "#/$defs/spectrum" },
        "yellow": { "$ref": "#/$defs/spectrum" }
      }
    },
    "baseDensity": { "$ref": "#/$defs/spectrum" },
    "interlayer": {
      "description": "3x3 interlayer (inter-image) effect matrix; identity in M2.",
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "negative" } } },
      "then": { "required": ["balanceIlluminantK", "midGreyLogExposure"] } },
    { "if": { "properties": { "type": { "const": "print" } } },
      "then": { "required": ["labAimDensity"] } }
  ],
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logSensitivity", "characteristicCurve"],
      "properties": {
        "logSensitivity": { "$ref": "#/$defs/spectrumSigned" },
        "characteristicCurve": {
          "description": "[log E (lux-seconds), density] pairs.",
          "type": "array", "minItems": 2,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "prefixItems": [{ "type": "number" }, { "type": "number", "minimum": 0 }]
          }
        }
      }
    },
    "spectrum": {
      "description": "[wavelength nm, non-negative value] pairs on the 5 nm grid.",
      "type": "array", "minItems": 2,
      "items": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "prefixItems": [
          { "type": "number", "minimum": 380, "maximum": 780, "multipleOf": 5 },
          { "type": "number", "minimum": 0 }
        ]
      }
    },
    "spectrumSigned": {
      "description": "[wavelength nm, log10 value] pairs on the 5 nm grid; a log value may be negative.",
      "type": "array", "minItems": 2,
      "items": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "prefixItems": [
          { "type": "number", "minimum": 380, "maximum": 780, "multipleOf": 5 },
          { "type": "number" }
        ]
      }
    }
  }
}
