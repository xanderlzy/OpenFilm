    "sources": [
      {
        "title": "BASE (7219 datasheet p.1): 'KODAK VISION3 500T Color Negative Films 5219 and 7219 have an acetate safety base with rem-jet backing'. ASSUMPTION: base thickness 0.127 mm (5 mil); the datasheet gives no thickness.",
        "url": "https://www.kodak.com/content/products-brochures/Film/VISION3-500T-Color-Negative-Film-7219-TECHNICAL-DATA.pdf",
        "note": "Acetate base with rem-jet is datasheet fact; 0.127 mm is assumed (Britannica gives 0.08-0.2 mm as the typical photographic base range)."
      },
      {
        "title": "ASSUMPTION: reflectanceOff 0.29 = diffuse internal reflectance of a base/air interface, 1 - (1 - 0.092)/n^2 with n = 1.48 (cellulose triacetate), about 0.585, times an assumed 0.5 ratio of red light reaching the base to red light absorbed in the emulsion.",
        "note": "No published rem-jet-off reflectance was found. Searches (halation literature, Kodak AHU talking points) describe the mechanism only: rem-jet absorbs light before it reflects off the rear base surface."
      },
      {
        "title": "ASSUMPTION: reflectanceOn 0.01 (carbon-black rem-jet leaves about 1 % of the light returned).",
        "note": "'On' is the as-shipped state: the 7219 datasheet p.1 BASE section states the stock has rem-jet backing. The 1 % figure is assumed."
      },
      {
        "title": "layerSplit is derived by build_stock.py from this stock's linear layer sensitivities over 600-700 nm, not typed in.",
        "note": "w_c = sum(s_c) / sum(s_red) over 600-700 nm."
      }
    ]
